{
  "name": "bg-helper-server",
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/jsdom": "^28.0.1"
  },
  "dependencies": {
    "@elysiajs/server-timing": "^1.4.0",
    "bgutils-js": "^3.2.0",
    "elysia": "^1.4.28",
    "jsdom": "^29.0.1"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir ./dist",
    "build-native": "bun build src/index.ts --compile --outfile ./dist/bg-helper-server",
    "start": "NODE_ENV=production bun dist/index.js",
    "test": "bun test"
  }
}
