{
  "name": "bg-helper-server",
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^30.0.0"
  },
  "dependencies": {
    "@elysiajs/server-timing": "^1.4.1",
    "bgutils-js": "^3.2.0",
    "elysia": "^1.4.30",
    "jsdom": "^30.0.1"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir ./dist --external css-tree",
    "build-native": "bun build src/index.ts --compile --outfile ./dist/bg-helper-server",
    "start": "NODE_ENV=production bun dist/index.js",
    "test": "bun test"
  }
}
